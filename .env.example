# Copy to .env and fill in. Never commit a real token.
SIDECAR_TOKEN=
# Bundled, self-contained corpus (corpus/catalog.json + corpus/policies.json).
# Point at a Laravel export (e.g. ../ceit-library/storage/app/ai-corpus) to use
# a fresh export instead.
CORPUS_PATH=corpus
MODEL_NAME=all-MiniLM-L6-v2
# Retrieval backend: sqlite (shipped FTS5+numpy) | pgvector (index storage and
# health for now — search and recommend land in later tickets).
VECTOR_BACKEND=sqlite
# Postgres connection string for VECTOR_BACKEND=pgvector (e.g. Neon).
DATABASE_URL=
# PG_INDEX_SCHEMA=public   schema holding the documents/index_state tables
# PG_CONNECT_TIMEOUT=15    seconds to wait for the database before /health degrades
# Below this top-cosine the semantic channel is treated as "no relevant match"
# (off-corpus queries return nothing instead of nearest-neighbour noise).
MIN_SEMANTIC_SIMILARITY=0.5
HOST=127.0.0.1
PORT=8310
# LLM chat (ADR 0001: OpenRouter via openai SDK)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Optional comma-separated fallback keys; on 429/402/401 the next key is
# tried automatically. If set, takes precedence over LLM_API_KEY.
# LLM_API_KEYS=key1,key2,key3
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_MAX_TOKENS=512
# Best-practice extras in the /search flow (degrade safely without an LLM key):
# QUERY_REWRITE=1 rewrites user queries into keyword search queries;
# RERANK_MODE=blend (deterministic, no model) | llm (RankGPT-style listwise)
# | none.
QUERY_REWRITE=true
RERANK_MODE=blend
# Durable thumbs up/down feedback log written by POST /feedback.
FEEDBACK_PATH=var/feedback.jsonl
# Required by docker-compose (Grafana admin password — set a non-default value).
GRAFANA_ADMIN_PASSWORD=
